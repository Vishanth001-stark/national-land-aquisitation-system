generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums
enum RoleName {
  CENTRAL_MINISTRY
  STATE_NODAL
  DISTRICT_COLLECTOR
  LAND_ACQUIRING_BODY
  LAND_REVENUE_OFFICER
  TEHSILDAR
  RR_OFFICER
  FINANCE_OFFICER
  CITIZEN
  SYSTEM_ADMIN
}

enum ProjectType {
  highway
  railway
  irrigation
  industrial_corridor
  urban_development
  renewable_energy
}

enum WorkflowStage {
  SIA
  PRELIMINARY_NOTIFICATION
  OBJECTIONS_CONSENT
  DECLARATION
  AWARD
  COMPENSATION
  POSSESSION
}

enum WorkflowStatus {
  PENDING
  IN_PROGRESS
  APPROVED
  REJECTED
  COMPLETED
}

enum LandType {
  agricultural
  forest
  wasteland
  residential
  commercial
  government
}

enum PossessionStatus {
  NOT_ACQUIRED
  ACQUIRED
  POSSESSED
}

enum PaymentMode {
  bank_transfer
  cheque
  cash
  pending
}

enum CompensationStatus {
  assessed
  approved
  paid
  rejected
}

// Models
model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  passwordHash String
  roleId    String
  role      Role     @relation(fields: [roleId], references: [id])
  stateId   String?
  state     State?   @relation(fields: [stateId], references: [id])
  districtId String?
  district  District? @relation(fields: [districtId], references: [id])
  documents Document[]
  projects  Project[] @relation("ProjectCreator")
  proposals Proposal[] @relation("SubmittedProposals")
  auditLogs AuditLog[]
  ownedLandParcels LandParcel[] @relation("ParcelOwner")
  invitationsCreated Invitation[] @relation("InvitationCreator")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Role {
  id          String   @id @default(uuid())
  name        RoleName @unique
  description String?
  users       User[]
  createdAt   DateTime @default(now())

  @@map("roles")
}

model State {
  id        String     @id @default(uuid())
  name      String
  code      String     @unique
  districts District[]
  users     User[]
  projects  Project[]
  projectProposals ProjectProposal[]
  createdAt DateTime   @default(now())

  @@map("states")
}

model District {
  id        String   @id @default(uuid())
  name      String
  stateId   String
  state     State    @relation(fields: [stateId], references: [id])
  users     User[]
  projects  Project[]
  projectProposals ProjectProposal[]
  createdAt DateTime @default(now())

  @@map("districts")
}

model Project {
  id              String        @id @default(uuid())
  name            String
  acquiringBodyId String?
  projectType     ProjectType
  stateId         String
  state           State         @relation(fields: [stateId], references: [id])
  districtId      String
  district        District      @relation(fields: [districtId], references: [id])
  status          String        @default("proposal")
  totalAreaHectares Decimal?
  estimatedCost   Decimal?
  createdBy       String
  creator         User          @relation("ProjectCreator", fields: [createdBy], references: [id])
  proposalId      String?       @unique
  proposal        Proposal?     @relation(fields: [proposalId], references: [id])
  workflowInstances WorkflowInstance[]
  landParcels     LandParcel[]
  documents       Document[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status])
  @@index([createdBy])
  @@map("projects")
}

model WorkflowInstance {
  id            String         @id @default(uuid())
  projectId     String
  project       Project        @relation(fields: [projectId], references: [id])
  currentStage  WorkflowStage
  status        WorkflowStatus @default(PENDING)
  slaDeadline   DateTime?
  startedAt     DateTime       @default(now())
  completedAt   DateTime?
  createdAt     DateTime       @default(now())

  @@map("workflow_instances")
}

model LandParcel {
  id               String          @id @default(uuid())
  projectId        String?
  project          Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  ulpin            String?
  surveyNumber     String?
  areaHectares     Decimal?
  landType         LandType?
  ownerName        String?
  ownerId          String?
  owner            User?           @relation("ParcelOwner", fields: [ownerId], references: [id])
  compensationAmount Decimal?
  possessionStatus PossessionStatus @default(NOT_ACQUIRED)
  latitude         Decimal?
  longitude        Decimal?
  geometryJson     Json?
  isCandidate      Boolean         @default(false)
  invitations      Invitation[]
  createdAt        DateTime        @default(now())

  compensationRecords CompensationRecord[]

  @@index([ownerId])
  @@map("land_parcels")
}

model Invitation {
  id           String      @id @default(uuid())
  code         String      @unique
  landParcelId String
  landParcel   LandParcel  @relation(fields: [landParcelId], references: [id], onDelete: Cascade)
  ownerName    String
  ownerPhone   String?
  ownerEmail   String?
  status       String      @default("PENDING")
  expiresAt    DateTime
  createdById  String
  createdBy    User        @relation("InvitationCreator", fields: [createdById], references: [id])
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@map("invitations")
}

model Document {
  id          String   @id @default(uuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id])
  documentType String
  filePath    String
  fileSize    Int?
  mimeType    String?
  uploadedBy  String
  uploader    User     @relation(fields: [uploadedBy], references: [id])
  version     Int      @default(1)
  createdAt   DateTime @default(now())

  @@map("documents")
}

model CompensationRecord {
  id              String             @id @default(uuid())
  landParcelId    String?
  landParcel      LandParcel?        @relation(fields: [landParcelId], references: [id])
  assessedAmount  Decimal?
  paidAmount      Decimal?
  paymentDate     DateTime?
  paymentMode     PaymentMode?
  bankAccountHash String?
  status          CompensationStatus @default(assessed)
  createdAt       DateTime           @default(now())

  @@map("compensation_records")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@map("audit_logs")
}

model Proposal {
  id              String   @id @default(uuid())
  title           String
  description     String
  landArea        Float
  location        String
  estimatedCost   Float
  purpose         String
  status          String   @default("draft")
  submittedBy     String
  submittedByUser User     @relation("SubmittedProposals", fields: [submittedBy], references: [id])
  project         Project?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([submittedBy])
  @@index([status])
  @@map("proposals")
}

model ProjectProposal {
  id                 String             @id @default(uuid())
  proposalCode       String             @unique @map("proposal_code")
  title              String
  sponsoringMinistry String             @map("sponsoring_ministry")
  category           String             @default("GREENFIELD")
  estimatedBudgetCr  Decimal            @map("estimated_budget_cr")
  status             String             @default("PROPOSAL_DRAFT")
  projectId          String?            @map("project_id")
  stateId            String?            @map("state_id")
  state              State?             @relation(fields: [stateId], references: [id])
  districtId         String?            @map("district_id")
  district           District?          @relation(fields: [districtId], references: [id])
  createdAt          DateTime           @default(now()) @map("created_at")
  alignments         ProposalAlignment[]
  clearances         StatutoryClearance[]
  financialSanction  FinancialSanction?

  @@map("project_proposals")
}

model ProposalAlignment {
  id                 String             @id @default(uuid())
  proposalId         String             @map("proposal_id")
  proposal           ProjectProposal    @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  alignmentName      String             @map("alignment_name")
  isPreferred        Boolean            @default(false) @map("is_preferred")
  bufferWidthMeters  Int                @default(60) @map("buffer_width_meters")
  centerlineGeom     Unsupported("geometry(LineString, 4326)")? @map("centerline_geom")
  corridorGeom       Unsupported("geometry(Polygon, 4326)")? @map("corridor_geom")
  totalLengthKm      Decimal?           @map("total_length_km")
  forestOverlapHa    Decimal?           @default(0) @map("forest_overlap_ha")
  waterbodyOverlapHa Decimal?           @default(0) @map("waterbody_overlap_ha")
  clearanceRiskScore String?            @map("clearance_risk_score")

  @@map("proposal_alignments")
}

model StatutoryClearance {
  id            String          @id @default(uuid())
  proposalId    String          @map("proposal_id")
  proposal      ProjectProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  clearanceType String          @map("clearance_type")
  status        String          @default("NOT_APPLIED")
  referenceNo   String?         @map("reference_no")
  submittedDate DateTime?       @map("submitted_date")
  approvalDate  DateTime?       @map("approval_date")
  remarks       String?

  @@map("statutory_clearances")
}

model FinancialSanction {
  id                       String          @id @default(uuid())
  proposalId               String          @unique @map("proposal_id")
  proposal                 ProjectProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  sanctionOrderNo          String          @map("sanction_order_no")
  sanctionedAmountCr       Decimal         @map("sanctioned_amount_cr")
  landAcquisitionBudgetCr  Decimal         @map("land_acquisition_budget_cr")
  civilWorksBudgetCr       Decimal         @map("civil_works_budget_cr")
  sanctioningAuthority     String          @map("sanctioning_authority")
  sanctionDate             DateTime        @map("sanction_date")
  documentHash             String?         @map("document_hash")

  @@map("financial_sanctions")
}

model ForestZone {
  id   String @id @default(uuid())
  name String
  geom Unsupported("geometry(MultiPolygon, 4326)")

  @@map("forest_zones")
}

model WaterBody {
  id   String @id @default(uuid())
  name String
  geom Unsupported("geometry(MultiPolygon, 4326)")

  @@map("water_bodies")
}

model UtilityCrossing {
  id   String @id @default(uuid())
  name String
  geom Unsupported("geometry(MultiLineString, 4326)")

  @@map("utility_crossings")
}


