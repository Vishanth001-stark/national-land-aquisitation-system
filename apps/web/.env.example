# Database
DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/land_acquisition?schema=public"

# NextAuth
NEXTAUTH_SECRET="generate-a-secure-secret-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# MinIO (document storage)
MINIO_ENDPOINT="localhost:9000"
MINIO_ACCESS_KEY="CHANGE_ME"
MINIO_SECRET_KEY="CHANGE_ME"
MINIO_BUCKET="land-documents"

# Docker Compose secrets (used by docker-compose.yml)
POSTGRES_DB=land_acquisition
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME
